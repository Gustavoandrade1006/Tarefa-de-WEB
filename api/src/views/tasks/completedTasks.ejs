<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Completed tasks</title>
</head>
<body>
    <h2>Todas as tasks Concluidas</h2>

    <% if (tasks.length === 0) { %>
        <p>Nenhuma tarefa encontrada!</p>
    <% } else { %>
        <ul>
            <% tasks.forEach( t => { %>
                <li>
                    <%= t.id %> - <%= t.title %>: <%= t.completed ? "completo" : "incompleto" %>
                </li>
            <% }); %>
        </ul>
    <% }; %>
</body>
</html>