<h1>Create Task</h1>
<form action="/tasks/create" method="POST">
    title: <input type="text" name="title">
    completed: <select name="completed">
        <option value="0">Pendente</option>
        <option value="1">Concluída</option>
    </select>
    <button type="submit">Criar tarefa</button>
</form>