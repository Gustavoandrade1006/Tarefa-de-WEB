<div class="card shadow-sm">
<div class="card-body">
<h1 class="h4 mb-3">Create Task</h1>
<form action="/tasks/create" method="POST">
<div class="mb-3"><label class="form-label">title:</label> <input class="form-control" type="text" name="title"></div>
<div class="mb-3"><label class="form-label">completed:</label> <select class="form-select" name="completed">
        <option value="0">Pendente</option>
        <option value="1">Concluída</option>
    </select></div>
    <button class="btn btn-primary" type="submit">Criar tarefa</button>
</form>
</div>
</div>