<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mostrar Tasks</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light"><main class="container py-5">
    <h1 class="mb-4">Todas as Tasks</h1>
    
    <% if (tasks.length === 0) { %>
        <p class="alert alert-secondary">Nenhuma tarefa encontrada!</p>
    <% } else { %>
        <ul class="list-group">
            <% tasks.forEach( t => { %>
                <li class="list-group-item">
                    <%= t.id %> - <%= t.title %>: <%= t.completed ? "completo" : "incompleto" %>
                </li>
            <% }); %>
        </ul>
    <% }; %>
</main></body>
</html>
