<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mostrar Task</title>
</head>
<body>
    <h1>Uma Task</h1>
    <% if (!task) { %>
        <p>Nenhuma tarefa encontrada!</p>
        <% } else { %>
            <ul>
                <li>
                    <%= task.id %> - <%= task.title %>: <%= task.completed ? "completo" : "incompleto" %>
                </li>
            </ul>
            <% }; %>
</body>
</html>